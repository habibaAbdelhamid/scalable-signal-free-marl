+    def _process_traj(self, s, a, r, s1, d, logp, **kwargs):
+        """
+        Input are all in shape [batch_size, T, n_agent, dim].
+        In dynamic mode, n_agent=1 (per-vehicle trajectories).
+
+        C6 (learner-fixes spec): an optional `mask` kwarg ([b, T, n], 1=real
+        step, 0=right-padding) masks reward/value, bootstraps GAE from each
+        trajectory's LAST REAL s1 (not the padded tail), freezes the backward
+        recursion across padded steps, and uses masked advantage-normalisation
+        statistics. The mask is only ever passed on the gated dynamic path
+        (DMPO_DYNAMIC_MASK=1); every legacy caller omits it → byte-identical.
+        """
+        mask = kwargs.get('mask', None)
+        b, T, n, dim_s = s.shape
+        s, a, r, s1, d, logp = [item.to(self.device) for item in [s, a, r, s1, d, logp]]
+        mask_4d = None
+        if mask is not None:
+            mask = mask.to(self.device).float()
+            if mask.dim() == 2:                       # [T, n] -> [b, T, n]
+                mask = mask.unsqueeze(0).expand(b, -1, -1)
+            mask_4d = mask.unsqueeze(-1)              # [b, T, n, 1]
+            # C6.3: padded steps carry no reward.
+            r = r * mask_4d
+        value = self._evalV(s.view(-1, n, dim_s)).view(b, T, n, -1)
+        if mask_4d is not None:
+            # C6.3: padded observations decode to the running mean (z-norm zeros);
+            # zero their value predictions so they cannot leak into GAE.
+            value = value * mask_4d
+
+        returns = torch.zeros(value.size(), device=self.device)
+        deltas, advantages = torch.zeros_like(returns), torch.zeros_like(returns)
+        if mask is not None and self.dynamic:
+            # C6.4: bootstrap from each trajectory's LAST REAL s1 (padding is a
+            # right-pad, so length-1 indexes the final real step). Without this,
+            # every truncated trajectory bootstraps off V(pad) = V(mean-obs).
+            # (Padded slot masks are NOT right-pads — slots empty and refill — so the
+            # PAD-FIX path bootstraps from the episode's last step below; empty slots
+            # never reach a real step's bootstrap because a departing vehicle is done.)
+            last_idx = mask[:, :, 0].sum(dim=1).long().clamp(min=1) - 1          # [b]
+            s1_last = s1[torch.arange(b, device=self.device), last_idx]          # [b, n, dim]
+            prev_value = self._evalV(s1_last)
+        else:
+            prev_value = self._evalV(s1.select(1, T - 1))
+        if not self.use_rtg:
+            prev_return = prev_value
+        else:
+            prev_return = torch.zeros_like(prev_value)
+        prev_advantage = torch.zeros_like(prev_return)
+        d_mask = d.float()
+        for t in reversed(range(T)):
+            deltas[:, t, :, :]= r.select(1, t) + self.gamma * (1-d_mask.select(1,t)) * prev_value - value.select(1, t).detach()
+            advantages[:, t, :, :] = deltas.select(1, t) + self.gamma * self.lamda * (1-d_mask.select(1,t)) * prev_advantage
+            if self.use_gae_returns:
+                returns[:, t, :, :] = value.select(1, t).detach() + advantages.select(1, t)
+            else:
+                returns[:, t, :, :] = r.select(1, t) + self.gamma * (1-d_mask.select(1, t)) * prev_return
+
+            if mask_4d is not None:
+                # C6.4: padded steps do NOT update the backward recursion — the
+                # carry "skips" them so the last real step sees V(s1_last), not 0.
+                m_t = mask_4d.select(1, t)                                        # [b, n, 1]
+                prev_return = m_t * returns.select(1, t) + (1 - m_t) * prev_return
+                prev_value = m_t * value.select(1, t) + (1 - m_t) * prev_value
+                prev_advantage = m_t * advantages.select(1, t) + (1 - m_t) * prev_advantage
+            else:
+                prev_return = returns.select(1, t)
+                prev_value = value.select(1, t)
+                prev_advantage = advantages.select(1, t)
+
+        if mask_4d is not None:
+            # C6.4: zero padded advantages/returns before normalisation/aggregation.
+            advantages = advantages * mask_4d
+            returns = returns * mask_4d
+
+        if self.dynamic:
+            # KAPPA-ADV (gated DMPO_KAPPA_ADV; provenance note 2026-07-25): the
+            # pristine original aggregates advantages over the κ-hop neighborhood
+            # UNCONDITIONALLY (first-commit DPPO:363, collect_v.reduce_sum) — that
+            # is the networked credit assignment the paper's guarantees attach to.
+            # The dynamic adaptation dropped it because MultiCollect's init-time
+            # matrix_power cannot express a per-step-varying graph (the earlier
+            # comment here claiming an independent-advantage DESIGN was written in
+            # this working tree with no commit history — a rationalized omission,
+            # not a decision). The trainer now attaches a per-batch sparse
+            # neighbor-sum operator S over (trajectory, local-step) slots, built
+            # from the ACTION-TIME graphs — the dynamic-graph generalization of
+            # reduce_sum. Flag off ⇒ the historical bypass, byte-identical.
+            _S = getattr(self, '_kappa_adv_S', None)
+            if _S is not None and os.environ.get('DMPO_KAPPA_ADV', '0') == '1':
+                _B, _T = advantages.size(0), advantages.size(1)
+                if _S.size(0) == _B * _T:
+                    _flat = advantages.reshape(_B * _T, 1)
+                    reduced_advantages = torch.sparse.mm(_S, _flat).reshape_as(advantages)
+                else:
+                    print(f"⚠️ KAPPA_ADV: operator size {_S.size(0)} != B*T={_B * _T} "
+                          f"— falling back to independent advantages this update")
+                    reduced_advantages = advantages
+            else:
+                reduced_advantages = advantages
+        else:
+            reduced_advantages = self.collect_v.reduce_sum(advantages.view(-1, n, 1)).view(advantages.size())
+
+        if self.advantage_norm and reduced_advantages.size()[1] > 1:
+            if mask_4d is not None:
+                # C6.5: masked normalisation statistics. Scope 'traj' (default)
+                # keeps the legacy per-trajectory-over-time axis (dim=1); 'batch'
+                # z-scores over the whole batch (standard PPO); 'scale' divides by
+                # the batch std WITHOUT mean subtraction — ROOT-CAUSE-2 fix from the
+                # saturation verification: per-traj (and even batch) mean-subtraction
+                # recenters a collision trajectory's advantages toward net-zero,
+                # neutralizing the −400's GO-vs-brake pressure and making the
+                # penalty MAGNITUDE gradient-irrelevant. Scale-only keeps gradients
+                # conditioned while preserving sign and relative magnitude.
+                _scope = os.environ.get('DMPO_ADV_NORM_SCOPE', 'traj')
+                if _scope == 'scale':
+                    n_v = mask_4d.sum().clamp(min=1.0)
+                    var_r = ((reduced_advantages ** 2) * mask_4d).sum() / n_v
+                    reduced_advantages = (reduced_advantages / (var_r.sqrt() + 1e-5)) * mask_4d
+                    var_a = ((advantages ** 2) * mask_4d).sum() / n_v
+                    advantages = (advantages / (var_a.sqrt() + 1e-5)) * mask_4d
+                else:
+                    _dims = (0, 1) if _scope == 'batch' else (1,)
+                    n_v = mask_4d.sum(dim=_dims, keepdim=True).clamp(min=1.0)
+                    mu_r = (reduced_advantages * mask_4d).sum(dim=_dims, keepdim=True) / n_v
+                    var_r = (((reduced_advantages - mu_r) ** 2) * mask_4d).sum(dim=_dims, keepdim=True) / n_v
+                    _adv_orig = advantages
+                    reduced_advantages = ((reduced_advantages - mu_r) / (var_r.sqrt() + 1e-5)) * mask_4d
+                    mu_a = (_adv_orig * mask_4d).sum(dim=_dims, keepdim=True) / n_v
+                    var_a = (((_adv_orig - mu_a) ** 2) * mask_4d).sum(dim=_dims, keepdim=True) / n_v
+                    advantages = ((_adv_orig - mu_a) / (var_a.sqrt() + 1e-5)) * mask_4d
+            else:
+                reduced_advantages = (reduced_advantages - reduced_advantages.mean(dim=1, keepdim=True)) / (reduced_advantages.std(dim=1, keepdim=True) + 1e-5)
+                advantages = (advantages - advantages.mean(dim=1, keepdim=True)) / (advantages.std(dim=1, keepdim=True) + 1e-5)
+
+        if mask_4d is not None and os.environ.get('DMPO_MASK_DEBUG', '1') == '1':
+            # C6.8: padded steps must carry exactly zero advantage (also traps NaN).
+            assert (advantages * (1 - mask_4d)).abs().max().item() == 0.0, \
+                "masked GAE leak: nonzero advantage at a padded step"
+
+        return value.detach(), returns, advantages.detach(), reduced_advantages.detach()
