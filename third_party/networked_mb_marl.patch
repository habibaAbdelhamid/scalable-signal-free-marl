+    def _evalV(self, s):
+        # Requires input in shape [-1, n_agent, dim]
+        s = s.to(self.device)
+
+        if self.dynamic:
+            # Shared value network: flatten agent dim into batch
+            batch, n, d_s = s.shape
+            s_flat = s.view(batch * n, d_s)
+            v = self.vs[0](s_flat)  # [batch*n, 1]
+            return v.view(batch, n, -1)
+
+        else:
+            # Original: per-agent value networks with neighbor gathering
+            s = self.collect_v.gather(s)
+            values = []
+            for i in range(self.n_agent):
+                values.append(self.vs[i](s[i]))
+            return torch.stack(values, dim=1)
+
+    def _init_actors(self):
+        if self.dynamic:
+            # One shared actor for all agents. Input = obs_dim (no neighbor concat).
+            collect_pi = IdentityCollect(device=self.device)
+            actors = nn.ModuleList()
+            self.pi_args.sizes[0] = self.observation_dim
+            actors.append(GaussianActor(action_dim=self.action_dim, **self.pi_args._toDict()).to(self.device))
+            return collect_pi, actors
+
+        else:
+            # Original: per-agent actors with neighbor gathering
+            collect_pi = MultiCollect(torch.matrix_power(self.adj, self.radius_pi), device=self.device)
+            actors = nn.ModuleList()
+            if self.env_name == "Large_city_2":
+                state_heterogeneous_space = np.loadtxt('state_heterogeneous_space.csv', delimiter=',')
+            for i in range(self.n_agent):
+                self.pi_args.sizes[0] = collect_pi.degree[i] * self.observation_dim
+                if self.discrete:
+                    if self.env_name == "Large_city_2":
+                        actors.append(CategoricalActor_for_heterogeneous_space(state_heterogeneous_space[i], **self.pi_args._toDict()).to(self.device))
+                    else:
+                        actors.append(CategoricalActor(**self.pi_args._toDict()).to(self.device))
+                else:
+                    actors.append(GaussianActor(action_dim=self.action_dim, **self.pi_args._toDict()).to(self.device))
+            return collect_pi, actors
+
+    def _init_vs(self):
+        if self.dynamic:
+            # One shared value network for all agents.
+            collect_v = IdentityCollect(device=self.device)
+            vs = nn.ModuleList()
+            self.v_args.sizes[0] = self.observation_dim
+            v_fn = self.v_args.network
+            vs.append(v_fn(**self.v_args._toDict()).to(self.device))
+            print("len = ", "dynamic (shared)")
+            return collect_v, vs
+
+        else:
+            # Original: per-agent value networks
+            print("len = ",sum(self.adj[1]))
+            collect_v = MultiCollect(torch.matrix_power(self.adj, self.radius_v), device=self.device)
+            vs = nn.ModuleList()
+            if self.env_name == "Large_city_2":
+                state_heterogeneous_space = np.loadtxt('state_heterogeneous_space.csv', delimiter=',')
+            for i in range(self.n_agent):
+                self.v_args.sizes[0] = collect_v.degree[i] * self.observation_dim
+                v_fn = self.v_args.network
+                if self.env_name == "Large_city_2":
+                    vs.append(v_fn(state_heterogeneous_space[i],**self.v_args._toDict()).to(self.device))
+                else:
+                    vs.append(v_fn(**self.v_args._toDict()).to(self.device))
+            return collect_v, vs
