+class IdentityCollect:
+    """Replacement for MultiCollect when dynamic=True.
+
+    No neighbor gathering — each agent sees only its own observation
+    (κ-hop neighbor info is already embedded in the observation by
+    ObservationProcessor).
+    """
+    def __init__(self, device='cuda'):
+        self.device = device
+
+    def gather(self, tensor):
+        """Input: [batch, n_agent, dim]. Return: list of [batch, dim] per agent."""
+        tensor = tensor.to(self.device)
+        return [tensor[:, i, :] for i in range(tensor.shape[1])]
+
+    def reduce_sum(self, tensor):
+        """Identity — no cross-agent reduction."""
+        return tensor
+
+    def reduce_mean(self, tensor):
+        """Identity — no cross-agent reduction."""
+        return tensor
+
+
+class DPPOAgent(nn.ModuleList):
+    """
+    Everything in and out is torch Tensor.
+
+    When dynamic=True (set via agent_args.dynamic):
+      - Parameter sharing: one shared actor + one shared value network
+      - Variable agent count: act/get_logp/_evalV accept any n_agent
+      - Per-vehicle trajectories: updateAgent expects n_agent=1 trajs
+      - No MultiCollect: neighbors already in observation
+    """
+    def __init__(self, logger, device, agent_args, env_args, **kwargs):
+        super().__init__()
+        self.logger = logger
+        self.device = device
+        self.n_agent = agent_args.n_agent
+        self.dynamic = getattr(agent_args, 'dynamic', False)
+        self.gamma = agent_args.gamma
+        self.lamda = agent_args.lamda
+        self.clip = agent_args.clip
+        self.target_kl = agent_args.target_kl
+        self.v_coeff = agent_args.v_coeff
+        self.v_thres = agent_args.v_thres
+        self.entropy_coeff = agent_args.entropy_coeff
+        self.lr = agent_args.lr
+        self.lr_v = agent_args.lr_v
+        self.n_update_v = agent_args.n_update_v
+        self.n_update_pi = agent_args.n_update_pi
+        self.n_minibatch = agent_args.n_minibatch
+        self.use_reduced_v = agent_args.use_reduced_v
+        self.use_rtg = agent_args.use_rtg
+        self.use_gae_returns = agent_args.use_gae_returns
+        self.env_name = env_args.env
+        self.algo_name = env_args.algo
+        self.advantage_norm = agent_args.advantage_norm
+        self.grad_clip = getattr(agent_args, 'grad_clip', 0.0)
+        self.observation_dim = agent_args.observation_dim
+        self.action_space = agent_args.action_space
+        self.discrete = isinstance(agent_args.action_space, Discrete)
+        if self.discrete:
+            self.action_dim = self.action_space.n
+            self.action_shape = self.action_dim
+
+        else:
+            self.action_shape = self.action_space.shape
+            self.action_dim = self.action_space.shape[0]
+            self.squeeze = agent_args.squeeze
+
+        self.adj = torch.as_tensor(agent_args.adj, device=self.device, dtype=torch.float)
+        self.radius_v = agent_args.radius_v
+        self.radius_pi = agent_args.radius_pi
+        self.pi_args = agent_args.pi_args
+        self.v_args = agent_args.v_args
+        self.collect_pi, self.actors = self._init_actors()
+        self.collect_v, self.vs = self._init_vs()
+
+        self.optimizer_v = Adam(self.vs.parameters(), lr=self.lr_v)
+        self.optimizer_pi = Adam(self.actors.parameters(), lr=self.lr)
+
+    def act(self, s, if_test=False, requires_log=False):
+        """
+        Requires input of [batch_size, n_agent, dim] or [n_agent, dim].
+        n_agent can vary per call when dynamic=True.
+        Returns a distribution with the same dimensions of input.
+        """
+        with torch.no_grad():
+            dim = s.dim()
+            while s.dim() <= 2:
+                s = s.unsqueeze(0)
+            s = s.to(self.device)
+
+            if self.dynamic:
+                # Shared actor: flatten agent dim into batch, single forward pass
+                b, n, d_s = s.shape
+                s_flat = s.view(b * n, d_s)  # [b*n, obs_dim]
+                mean, std = self.actors[0](s_flat)  # shared actor
+                mean = mean.view(b, n, -1)
+                std = std.view(b, n, -1)
+                while mean.dim() > dim:
+                    mean = mean.squeeze(0)
+                    std = std.squeeze(0)
+                return Normal(mean, std)
+
+            else:
+                # Original: per-agent actors with neighbor gathering
+                s = self.collect_pi.gather(s)
+                if self.discrete:
+                    if if_test:
+                        probs = []
+                        for i in range(self.n_agent):
+                            index = torch.argmax(self.actors[i](s[i])[0])
+                            action_p = torch.tensor([[0]*self.action_dim])
+                            action_p[0][index] = 1
+                            probs.append(action_p)
+                        probs = torch.stack(probs, dim=1)
+                        while probs.dim() > dim:
+                            probs = probs.squeeze(0)
+                        return Categorical(probs)
+                    else:
+                        probs = []
+                        for i in range(self.n_agent):
+                            probs.append(self.actors[i](s[i]))
+                        probs = torch.stack(probs, dim=1)
+                        while probs.dim() > dim:
+                            probs = probs.squeeze(0)
+                        return Categorical(probs)
+                else:
+                    means, stds = [], []
+                    for i in range(self.n_agent):
+                        mean, std = self.actors[i](s[i])
+                        means.append(mean)
+                        stds.append(std)
+                    means = torch.stack(means, dim=1)
+                    stds = torch.stack(stds, dim=1)
+                    while means.dim() > dim:
+                        means = means.squeeze(0)
+                        stds = stds.squeeze(0)
+                    return Normal(means, stds)
+
+    def get_logp(self, s, a):
+        """
+        Requires input of [batch_size, n_agent, dim] or [n_agent, dim].
+        Returns a tensor whose dim() == 3.
+        """
+        s = torch.as_tensor(s, dtype=torch.float32, device=self.device)
+        dim = s.dim()
+
+        while s.dim() <= 2:
+            s = s.unsqueeze(0)
+            a = a.unsqueeze(0)
+        while a.dim() < s.dim():
+            a = a.unsqueeze(-1)
+
+        if self.dynamic:
+            # Shared actor: flatten agent dim into batch
+            b, n, d_s = s.shape
+            d_a = a.shape[-1]
+            s_flat = s.view(b * n, d_s)
+            a_flat = a.view(b * n, d_a)
+            log_prob = self.actors[0](s_flat, a_flat)  # [b*n]
+            log_prob = log_prob.view(b, n)
+            while log_prob.dim() < 3:
+                log_prob = log_prob.unsqueeze(-1)
+            return log_prob
+
+        else:
+            # Original: per-agent actors
+            s = self.collect_pi.gather(s)
+            log_prob = []
+            for i in range(self.n_agent):
+                if self.discrete:
+                    probs = self.actors[i](s[i])
+                    log_prob.append(torch.log(torch.gather(probs, dim=-1, index=torch.select(a, dim=1, index=i).long())))
+                else:
+                    log_prob.append(self.actors[i](s[i], a.select(dim=1, index=i)))
+            log_prob = torch.stack(log_prob, dim=1)
+            while log_prob.dim() < 3:
+                log_prob = log_prob.unsqueeze(-1)
+            return log_prob
+
+    def updateAgent(self, trajs, clip=None):
+        time_t = time.time()
+        if clip is None:
+            clip = self.clip
+        n_minibatch = self.n_minibatch
+
+        names = Trajectory.names()
+        traj_all = {name:[] for name in names}
+
+        # =============================================================================
+        # TRUE FIX for SUSPECT 18 (Zero Log Probs) & SUSPECT 5 (Variable Agent Count)
+        # =============================================================================
+        # Extract agent masks if present. Mask=1.0 for real agents, 0.0 for padded.
+        # C6 (learner-fixes spec, 2026-07): in dynamic mode per-vehicle trajs of
+        # unequal length are right-padded to T_max below, so 35-70% of every
+        # gradient sample can be padding (obs = z-norm zeros = the running mean,
+        # advantage = -V(pad), value target 0). DMPO_DYNAMIC_MASK=1 turns the
+        # existing mask machinery on for dynamic mode (masks are synthesised as
+        # ones for each real step and zero-padded, then flow through GAE and all
+        # losses). Default '0' = legacy byte-identical behaviour.
+        # PAD-FIX (gated DMPO_PAD_FIX=1, padded mode only; default off = byte-identical):
+        # open the same masked KL / surrogate / value / logit-penalty path for padded
+        # slot masks, so a padded arm uses exactly the dynamic arms' learner.
+        _pad_fix = (not self.dynamic) and os.environ.get('DMPO_PAD_FIX', '0') == '1'
+        _dyn_mask_gate = (self.dynamic or _pad_fix) and os.environ.get('DMPO_DYNAMIC_MASK', '0') == '1'
+        if self.dynamic:
