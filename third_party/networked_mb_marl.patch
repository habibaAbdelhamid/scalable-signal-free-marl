+class DynamicGraphConvolutionalModel(nn.Module):
+    """Weight-shared GCN for variable agent counts.
+
+    Unlike GraphConvolutionalModel which creates per-agent/per-edge networks,
+    this uses ONE shared EdgeNetwork, ONE shared NodeNetwork, and ONE shared
+    embedding Linear for all agents/edges. The adjacency is passed at runtime
+    (not fixed at init), enabling variable agent counts.
+
+    Interface matches GraphConvolutionalModel (predict, train, forward) so
+    DMPO.py can use it as a drop-in replacement.
+    """
+
+    def __init__(self, logger, state_dim, action_dim, p_args):
+        super().__init__()
+        self.logger = logger.child("p") if hasattr(logger, 'child') else logger
+        self.state_dim = state_dim
+        self.action_dim = action_dim
+        self.n_conv = p_args.n_conv
+        self.n_embedding = p_args.n_embedding
+        self.residual = p_args.residual
+        self.edge_embed_dim = p_args.edge_embed_dim
+        self.node_embed_dim = p_args.node_embed_dim
+        self.reward_coeff = p_args.reward_coeff
+
+        # Shared node embedding: state_dim → node_embed_dim
+        self.node_embedding = nn.Sequential(
+            nn.Linear(state_dim, self.node_embed_dim), nn.ReLU()
+        )
+
+        # Shared edge network: [node_embed_dim * 2] → edge_embed_dim
+        edge_sizes = [self.node_embed_dim * 2] + list(p_args.edge_hidden_size) + [self.edge_embed_dim]
+        edge_layers = []
+        for t in range(len(edge_sizes) - 1):
+            act = nn.ReLU() if t < len(edge_sizes) - 2 else nn.Identity()
+            edge_layers += [nn.Linear(edge_sizes[t], edge_sizes[t + 1]), act]
+        self.shared_edge_net = nn.Sequential(*edge_layers)
+
+        # Shared node network: [edge_embed_dim + action_dim] → node_embed_dim
+        action_dim_eff = self.n_embedding if self.n_embedding > 0 else action_dim
+        node_sizes = [self.edge_embed_dim + action_dim_eff] + list(p_args.node_hidden_size) + [self.node_embed_dim]
+        node_layers = []
+        for t in range(len(node_sizes) - 1):
+            act = nn.ReLU() if t < len(node_sizes) - 2 else nn.ReLU()
+            node_layers += [nn.Linear(node_sizes[t], node_sizes[t + 1]), act]
+        self.shared_node_net = nn.Sequential(*node_layers)
+
+        # Output heads (shared across all agents)
+        self.state_head = nn.Linear(self.node_embed_dim, state_dim)
+        self.reward_head = nn.Linear(self.node_embed_dim, 1)
+        self.done_head = nn.Sequential(nn.Linear(self.node_embed_dim, 1), nn.Sigmoid())
+
+        self.MSE = nn.MSELoss(reduction='none')
+        self.BCE = nn.BCELoss(reduction='none')
+
+    def predict(self, s, a, adj=None):
+        """
+        Input:
+            s: [batch_size, n_agent, state_dim]
+            a: [batch_size, n_agent, action_dim]
+            adj: [n_agent, n_agent] bool/float (optional, defaults to fully connected)
+        """
+        with torch.no_grad():
+            r1, s1, d1 = self.forward(s, a, adj)
+            done = torch.clamp(d1, 0., 1.)
+            done = torch.cat([1 - done, done], dim=-1)
+            done = Categorical(done).sample() > 0
+            return r1, s1, done
+
+    def train_model(self, s, a, r, s1, d, length=1, adj=None):
+        """
+        Input shape: [batch_size, T, n_agent, dim].
+        Named train_model to avoid conflict with nn.Module.train().
+        """
+        pred_s, pred_r, pred_d = [], [], []
+        s0 = s.select(dim=1, index=0)
+        length = min(length, s.shape[1])
+
+        for t in range(length):
+            r_, s_, d_ = self.forward(s0, a.select(dim=1, index=t), adj)
+            pred_r.append(r_)
+            pred_s.append(s_)
+            pred_d.append(d_)
+            s0 = s_
+        reward_pred = torch.stack(pred_r, dim=1)
+        state_pred = torch.stack(pred_s, dim=1)
+        done_pred = torch.stack(pred_d, dim=1)
+
+        state_loss = self.MSE(state_pred, s1).mean()
+        s1_view = s1.view(-1, s1.shape[-1])
+        state_var = self.MSE(s1_view, s1_view.mean(dim=0, keepdim=True).expand(*s1_view.shape))
+        rel_state_loss = state_loss / (state_var.mean() + 1e-7)
+        self.logger.log(state_loss=state_loss, state_var=state_var.mean(), rel_state_loss=rel_state_loss)
+        loss = state_loss
+
+        reward_loss = self.MSE(reward_pred, r)
+        loss += self.reward_coeff * reward_loss.mean()
+        r_view = r.view(-1, r.shape[-1])
+        reward_var = self.MSE(r_view, r_view.mean(dim=0, keepdim=True).expand(*r_view.shape)).mean()
+        rel_reward_loss = reward_loss.mean() / (reward_var.mean() + 1e-7)
+        self.logger.log(reward_loss=reward_loss, reward_var=reward_var, reward=r,
+                        reward_norm=torch.norm(r), rel_reward_loss=rel_reward_loss)
+
+        d = d.float()
+        done_loss = self.BCE(done_pred, d)
+        loss = loss + done_loss.mean()
+        done = done_pred > 0
+        done_true_positive = (done * d).mean()
+        d = d.mean()
+        self.logger.log(done_loss=done_loss, done_true_positive=done_true_positive, done=d, rolling=100)
+
+        return (loss, rel_state_loss)
+
+    def forward(self, s, a, adj=None):
+        """
+        Input:
+            s: [batch_size, n_agent, state_dim]
+            a: [batch_size, n_agent, action_dim]
+            adj: [n_agent, n_agent] — adjacency (optional, defaults to fully connected)
+        Output: reward_pred, state_pred, done_pred — all [batch_size, n_agent, dim]
+        """
+        b, n, _ = s.shape
+
+        # Build adjacency if not provided (fully connected)
+        if adj is None:
+            adj = torch.ones(n, n, device=s.device, dtype=torch.bool)
+
+        # Node embedding: [b, n, state_dim] → [b, n, node_embed_dim]
+        embedding = self.node_embedding(s)
+
+        for _ in range(self.n_conv):
+            # Compute edge features for all connected pairs
+            # edge_agg[i] = sum of shared_edge_net(embed_i || embed_j) for j in neighbors(i)
+            edge_agg = torch.zeros(b, n, self.edge_embed_dim, device=s.device)
+            for i in range(n):
+                neighbors = torch.nonzero(adj[i], as_tuple=True)[0]
+                if len(neighbors) == 0:
+                    continue
+                # embed_i repeated: [b, |N(i)|, node_embed_dim]
+                embed_i = embedding[:, i:i+1, :].expand(b, len(neighbors), -1)
+                # embed_j for all neighbors: [b, |N(i)|, node_embed_dim]
+                embed_j = embedding[:, neighbors, :]
+                # Concatenate and compute edge features
+                edge_input = torch.cat([embed_i, embed_j], dim=-1)  # [b, |N(i)|, 2*node_embed_dim]
+                edge_feats = self.shared_edge_net(edge_input)  # [b, |N(i)|, edge_embed_dim]
+                edge_agg[:, i, :] = edge_feats.sum(dim=1)  # sum over neighbors
+
+            # Node update: [edge_agg || action] → new embedding
+            node_input = torch.cat([edge_agg, a], dim=-1)  # [b, n, edge_embed_dim + action_dim]
+            embedding = self.shared_node_net(node_input)  # [b, n, node_embed_dim]
+
+        state_pred = self.state_head(embedding)
+        if self.residual:
+            state_pred += s
+        reward_pred = self.reward_head(embedding)
+        done_pred = self.done_head(embedding)
+        return reward_pred, state_pred, done_pred
+
